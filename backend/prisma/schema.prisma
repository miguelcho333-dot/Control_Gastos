generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cierres_diarios {
  id                 BigInt        @id @default(autoincrement())
  fecha_operativa    DateTime      @unique @db.Date
  base_inicial       Decimal       @db.Decimal(12, 2)
  efectivo_fisico    Decimal       @db.Decimal(12, 2)
  dinero_digital     Decimal       @default(0) @db.Decimal(12, 2)
  dinero_final_total Decimal?      @default(dbgenerated("(efectivo_fisico + dinero_digital)")) @db.Decimal(12, 2)
  base_siguiente_dia Decimal       @db.Decimal(12, 2)
  total_gastos       Decimal       @default(0) @db.Decimal(12, 2)
  total_inyecciones  Decimal       @default(0) @db.Decimal(12, 2)
  ventas_calculadas  Decimal       @db.Decimal(12, 2)
  colchon_resultante Decimal       @db.Decimal(12, 2)
  creado_en          DateTime?     @default(now()) @db.Timestamptz(6)
  gastos             gastos[]
  inyecciones        inyecciones[]

  @@index([fecha_operativa], map: "idx_cierres_fecha_operativa")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model gastos {
  id              BigInt           @id @default(autoincrement())
  monto           Decimal          @db.Decimal(12, 2)
  descripcion     String
  metodo_pago     String           @default("EFECTIVO") @db.VarChar(20)
  cierre_id       BigInt?
  fecha           DateTime?        @default(now()) @db.Timestamptz(6)
  cierres_diarios cierres_diarios? @relation(fields: [cierre_id], references: [id], onUpdate: NoAction)

  @@index([cierre_id], map: "idx_gastos_cierre_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model inyecciones {
  id              BigInt           @id @default(autoincrement())
  monto           Decimal          @db.Decimal(12, 2)
  fuente          String           @default("Colchón / Ganancias Pasadas") @db.VarChar(100)
  metodo_pago     String           @default("EFECTIVO") @db.VarChar(20)
  cierre_id       BigInt?
  fecha           DateTime?        @default(now()) @db.Timestamptz(6)
  cierres_diarios cierres_diarios? @relation(fields: [cierre_id], references: [id], onUpdate: NoAction)

  @@index([cierre_id], map: "idx_inyecciones_cierre_id")
}
